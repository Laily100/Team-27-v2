<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DiveDeepWebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DiveDeepWebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DiveDeepWebApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Categories
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="BCD">BCD</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Wetsuits">Dykkerdragter</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Tanks">Tanke</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Regulators">Regulatorsæt</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Masks">Maske/Snorkel</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Fins">Finner</a></li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white mt-5 p-4">
        <div class="container">

            <h5>DiveDeep Udlejning</h5>

            <p>
                <strong>Adresse:</strong> Dykkervej 10, 5000 Odense C<br />
                <strong>CVR-nummer:</strong> 81828384<br />
                <strong>Telefon:</strong> +45 60708090<br />
                <strong>E-mail:</strong> info@divedeep.dk
            </p>

            <h6>Åbningstider</h6>
            <ul class="list-unstyled">
                <li>Mandag-fredag: 10:00 - 17:30</li>
                <li>Lørdag: 10:00 - 14:00</li>
                <li>Søndag: Lukket</li>
            </ul>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
