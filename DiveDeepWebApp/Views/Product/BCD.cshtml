@{
}

@model List<DiveDeepWebApp.Models.Product>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-3 mb-4">

            <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.ProductId">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@product.Brand</h5>
                    
                            <p class="card-text">@product.Model</p>

                            <h6 class="card-text">Størrelse: @string.Join(", ", product.Sizes)</h6>


                            <h6 class="text-success">@product.PricePerDay kr pr. døgn</h6>

                            <a href="#" class="btn btn-primary">Edit</a>
                            <a href="#" class="btn btn-danger">Delete</a>
                        </div>
                    </div>

           </a>

        </div>
    }
</div>
