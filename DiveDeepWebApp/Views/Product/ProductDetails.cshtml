@{
}

@model DiveDeepWebApp.Models.Product

<h1>Product Details</h1>

<div class="row mt-4">

        <div class="col-md-6">

            <h2>@Model.Brand</h2>

            <h3>@Model.Model</h3>

            <p>Pris pr. dag: @Model.PricePerDay kr</p>

        </div>

        <div class="col-md-6">

                <a asp-controller="Booking"
                   asp-action="CreateBooking"
                   asp-route-id="@Model.ProductId"
                   class="btn btn-success mt-3">
                    Lej dette produkt
                </a>

        </div>


</div>
